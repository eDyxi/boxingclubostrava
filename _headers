# HTML se nesmi kesovat natvrdo, jinak prohlizec drzi starou stranku
# i s odkazem na starou verzi skriptu a opravy se k uzivateli nedostanou.
/*
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
